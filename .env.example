APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database connection settings. Generate a local password with: openssl rand -hex 32
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catalog
DB_USER=catalog
DB_PASSWORD=
DB_SSLMODE=disable
DB_SSLROOTCERT=

JWT_SECRET=
JWT_TTL=24h

# Payment gateway (Xendit)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMENT_SUCCESS_REDIRECT_URL=http://localhost:5173/payment/success

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@catalog.local

# Business rules
LOW_STOCK_THRESHOLD=5
EMAIL_QUEUE_SIZE=256

# Used by cmd/seed
SEED_ADMIN_EMAIL=admin@catalog.local
# 12-72 bytes; the seed command hashes this with bcrypt.
SEED_ADMIN_PASSWORD=
