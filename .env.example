APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog?sslmode=disable

JWT_SECRET=
JWT_TTL=24h

# Payment gateway (Xendit)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMENT_SUCCESS_REDIRECT_URL=http://localhost:5173/payment/success

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@catalog.local

# Business rules
LOW_STOCK_THRESHOLD=5
EMAIL_QUEUE_SIZE=256

# Dipakai oleh cmd/seed
SEED_ADMIN_EMAIL=admin@catalog.local
SEED_ADMIN_PASSWORD=
